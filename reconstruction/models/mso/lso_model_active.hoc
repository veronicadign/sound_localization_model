// LSO multicompartment morphology — active conductances, HUMAN dimensions
//
// Morphology (human):
//   Primary dendrites traceable to 400 um from the soma.
//   Soma sizes, transverse plane (major x minor axis, % of population):
//     stellate ~50%   27 x 13 um   (ellipse area 278 +/- 11 um2)
//     fusiform ~25%   34 x  9 um   (ellipse area 241 +/-  9 um2)
//     round    ~25%   21 x 14 um   (ellipse area 231 +/- 13 um2)
//   The soma below is the 50/25/25 weighted mean (27.25 x 12.25 -> L=27, dia=12),
//   mapped to a NEURON cylinder as length = major axis, diameter = minor axis.
//
// Channel kinetics: Rothman & Manis 2003 (klt, kht, nax, ih); AHP (ahp.mod).
// Conductance densities are gerbil-derived (Helfert & Schwartz 1987;
// Haragopal & Winters 2023) — they are per-area (S/cm2) and carry over unchanged,
// but they have NOT been validated against human data.
//
// Sections:
//   soma:   L = 27 um, dia = 12 um, elongated along z (major axis || dendritic axis)
//   dend_A: primary dendrite, +z, 400 um
//   dend_B: primary dendrite, -z, 400 um
//   dend_C: asymmetric branch, +x / dorsal, 213 um
//   axon:   -y (caudal), 150 um
//
// TWO KNOWN LIMITATIONS — both inflate/distort the modelled z-dipole:
//
//   1. Dendrite axis. dend_A/B are placed along z (mediolateral / probe axis) for
//      compatibility with HybridLFPy's z-based layer-boundary synapse assignment.
//      Anatomically, LSO primary dendrites are predominantly rostrocaudal (y), which
//      would produce a much weaker z-dipole than modelled here. Lengthening them to
//      the human 400 um makes this overstatement LARGER, not smaller.
//
//   2. Cell type. This is a BIPOLAR cell (two opposed primary dendrites) — i.e. the
//      fusiform type, only ~25% of the nucleus. The ~50% stellate cells are multipolar
//      and radiate dendrites in many directions, contributing a far weaker coherent
//      z-dipole. Applying this bipolar morphology to the whole population therefore
//      OVERSTATES the summed dipole.
//
// TWO MEASURED CONSEQUENCES of the 150 -> 400 um rescale (single-cell, NEURON):
//
//   a. The dendrites are now electrotonically LONG. With Rm = 500 ohm.cm2 (tau_m =
//      0.5 ms, the fast LSO membrane) the space constant is lambda ~ 144 um, so
//      L/lambda goes 1.04 -> 2.77. A distal dend_A synapse (0.040 uS) that produced a
//      5.36 mV somatic EPSP now produces 0.59 mV (attenuation 0.129 -> 0.013). Somatic
//      rheobase rises only 2 -> 3 nA, so the cell still fires; and the LFP pipeline
//      drives synapses from NEST spike trains rather than from this cell's own spiking,
//      so excitability is not on the critical path. Rm is gerbil-derived and unvalidated
//      for human — if human LSO has a higher Rm, this attenuation is overstated.
//
//   b. The net z-dipole barely benefits, because it largely SELF-CANCELS. dend_A (+z)
//      and dend_B (-z) receive the same SBC excitation, so their dipoles oppose. Peak
//      |Pz| is only 25 -> 37 nA.um (1.46x) and is dominated by stochastic asymmetry in
//      synapse placement (+/- ~18 nA.um over seeds), not by systematic geometry; |Px|
//      and |Py| are both larger than |Pz|. Dendrite LENGTH is therefore not what limits
//      this model's ABR-relevant dipole — the bipolar symmetry is.
//
// Passive params: E_L = -63 mV (params.py E_L.LSO).
// Conductances:
//   soma:       klt=0.010, kht=0.010, nax=0.10, ih=0.0005, ahp=0.002  S/cm2
//   dendrites:  klt=0.002, ih=0.0001                                   S/cm2
//   axon:       nax=0.35,  klt=0.010, kht=0.015, ih=0.0005             S/cm2

create soma, dend_A, dend_B, dend_C, axon

access soma

soma {
    nseg = 1
    Ra   = 150
    cm   = 1.0
    insert pas
    g_pas = 2.0e-3
    e_pas = -63.0
    insert klt
    gbar_klt = 0.010
    insert kht
    gbar_kht = 0.010
    insert ih
    gbar_ih = 0.0005
    insert nax
    gbar_nax = 0.10
    ena = 55.0
    ek  = -77.0
    insert lso_ahp
    gbar_lso_ahp = 0.002
    pt3dadd(0, 0, -13.5, 12)
    pt3dadd(0, 0,  13.5, 12)
}

// Primary dendrite A  (+z, 400 um, tapering 3.5 -> 1.5 um)
dend_A {
    nseg = 29
    Ra   = 150
    cm   = 1.0
    insert pas
    g_pas = 2.0e-3
    e_pas = -63.0
    insert klt
    gbar_klt = 0.002
    insert ih
    gbar_ih = 0.0001
    ek = -77.0
    pt3dadd(0, 0,  13.5, 3.5)
    pt3dadd(0, 0, 413.5, 1.5)
}

// Primary dendrite B  (-z, 400 um, tapering 3.5 -> 1.5 um)
dend_B {
    nseg = 29
    Ra   = 150
    cm   = 1.0
    insert pas
    g_pas = 2.0e-3
    e_pas = -63.0
    insert klt
    gbar_klt = 0.002
    insert ih
    gbar_ih = 0.0001
    ek = -77.0
    pt3dadd(0, 0,  -13.5, 3.5)
    pt3dadd(0, 0, -413.5, 1.5)
}

// Dorsal asymmetric branch  (+x, 213 um, tapering 3.0 -> 1.5 um)
dend_C {
    nseg = 15
    Ra   = 150
    cm   = 1.0
    insert pas
    g_pas = 2.0e-3
    e_pas = -63.0
    insert klt
    gbar_klt = 0.002
    insert ih
    gbar_ih = 0.0001
    ek = -77.0
    pt3dadd(  0, 0, 0, 3.0)
    pt3dadd(213, 0, 0, 1.5)
}

// Axon (-y / caudal, 150 um)
axon {
    nseg = 5
    Ra   = 150
    cm   = 1.0
    insert pas
    g_pas = 2.0e-3
    e_pas = -63.0
    insert nax
    gbar_nax = 0.35
    ena = 55.0
    insert klt
    gbar_klt = 0.010
    insert kht
    gbar_kht = 0.015
    insert ih
    gbar_ih = 0.0005
    ek = -77.0
    pt3dadd(  0,  -13.5, 0, 1.5)
    pt3dadd(  0, -163.5, 0, 1.5)
}

connect dend_A(0), soma(1)
connect dend_B(0), soma(0)
connect dend_C(0), soma(0.5)
connect axon(0),   soma(0.5)
